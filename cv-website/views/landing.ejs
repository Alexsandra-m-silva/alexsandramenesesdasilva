<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= siteData.meta.title %></title>
    <meta name="description" content="<%= siteData.meta.description %>" />
    <link rel="stylesheet" href="./public/styles.css" />
    <script src="https://cdn.jsdelivr.net/npm/p5@1.9.4/lib/p5.min.js"></script>
  </head>
  <body class="landing-page">
    <div id="p5-container"></div>

    <div class="landing-overlay">
      <div class="eyebrow">Creative portfolio</div>
      <h3>
        Hello World, I'm <span>Alexsandra.</span>
      </h3>
      <p>
        <%= siteData.about.intro %>
      </p>
      <div class="landing-actions">
        <a class="button primary" href="./portfolio.html">Explore portfolio</a>
        <a class="button secondary" href="./public/Resume_2026_en-us.pdf" download>Download PDF</a>
      </div>
    </div>

    <script src="./public/landing-animation.js"></script>
  </body>
</html>
